# ==============================================================================
# AI Tech News - Environment Configuration Template (.env)
# Sao chep file nay thanh .env va dieu chinh cac gia tri phu hop voi moi truong cua ban:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Main PostgreSQL Database (Du lieu nghiep vu tin tuc)
# ------------------------------------------------------------------------------
POSTGRES_USER=tech_admin
POSTGRES_PASSWORD=news_summary
POSTGRES_DB=tech_news_db
POSTGRES_PORT=15432

# ------------------------------------------------------------------------------
# 2. Application Ports & URLs
# ------------------------------------------------------------------------------
BACKEND_PORT=18080
FRONTEND_PORT=13000

# ------------------------------------------------------------------------------
# 3. Airflow Metadata Database (PostgreSQL rieng cho Airflow)
# ------------------------------------------------------------------------------
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# ------------------------------------------------------------------------------
# 4. Airflow Webserver & Admin Credentials
# ------------------------------------------------------------------------------
AIRFLOW_PORT=18088
AIRFLOW_SECRET_KEY=4686e72d25d79464b87638401f341eb2
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 5. Crawler & Scheduler Configurations
# ------------------------------------------------------------------------------
# Danh sach URLs phan cach bang dau phay can crawl thu cong hoac dinh ky
CRAWL_URLS=
CRAWL_SOURCE_ID=1
CRAWL_SOURCE_NAME=vnexpress
CRAWL_TIMEOUT_SECONDS=20
TZ=Asia/Ho_Chi_Minh
