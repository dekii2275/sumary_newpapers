# PostgreSQL Configuration (phục vụ ứng dụng và crawler)
POSTGRES_DB=tech_news_db
POSTGRES_USER=tech_admin
POSTGRES_PASSWORD=news_summary

# Cổng ánh xạ ra máy Host (Tránh xung đột với cổng mặc định 3000, 8000, 8080, 5432)
# Frontend: http://localhost:13000 hoặc http://127.0.0.1:13000
FRONTEND_PORT=13000

# Backend API: http://localhost:18080 (Health: http://localhost:18080/health)
BACKEND_PORT=18080

# Airflow Web UI: http://localhost:18088
AIRFLOW_PORT=18088

# PostgreSQL Host Port: localhost:15432
POSTGRES_PORT=15432

# Cấu hình cào báo VnExpress (Step 1)
CRAWL_URLS=https://vnexpress.net/so-hoa/cong-nghe
# One or more article URLs separated by commas.
# Leave empty for manual-only mode; an empty list disables the scheduled DAG.
CRAWL_URLS=
CRAWL_SOURCE_ID=1
CRAWL_SOURCE_NAME=vnexpress
CRAWL_TIMEOUT_SECONDS=20
CRAWL_SCHEDULE=0 */6 * * *

# Thông tin đăng nhập Airflow Web UI
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_SECRET_KEY=local-airflow-secret-key-12345
TZ=Asia/Ho_Chi_Minh
