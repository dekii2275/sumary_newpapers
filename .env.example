# PostgreSQL used by the news application and crawler.
POSTGRES_DB=news_db
POSTGRES_USER=news_user
POSTGRES_PASSWORD=news_password_dev

# One or more article URLs separated by commas.
# Leave empty for manual-only mode; an empty list disables the scheduled DAG.
CRAWL_URLS=
CRAWL_SOURCE_ID=1
CRAWL_SOURCE_NAME=vnexpress
CRAWL_TIMEOUT_SECONDS=20
CRAWL_SCHEDULE=0 */6 * * *

# Local Airflow UI credentials.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_SECRET_KEY=change-this-local-secret
